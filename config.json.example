{
  "x_api": {
    "consumer_key": "",
    "consumer_secret": "",
    "access_token": "",
    "access_token_secret": "",
    "bearer_token": ""
  },
  "openai": {
    "api_key": "",
    "enabled": false,
    "model": "gpt-3.5-turbo",
    "temperature": 0.7
  },
  "schedule": {
    "morning_time": "09:00",
    "evening_time": "18:00",
    "timezone": "UTC"
  },
  "reply_settings": {
    "max_replies_per_run": 10,
    "delay_minutes_min": 30,
    "delay_minutes_max": 40,
    "timeline_count": 50,
    "keyword_search_count": 20
  },
  "keywords": [
    "python programming",
    "AI ethics",
    "machine learning"
  ],
  "reply_templates": [
    "That's an interesting perspective! {context}",
    "Thanks for sharing this. I've been thinking about {topic} recently.",
    "Great point! Have you considered {related_idea}?",
    "This resonates with me. {personal_insight}"
  ],
  "tweet_templates": [
    "Sharing some thoughts on AI and technology today...",
    "Just reflecting on the latest developments in tech.",
    "Interesting day for innovation and creativity.",
    "Thinking about the future of technology and how it shapes our world.",
    "Always amazed by the pace of innovation in tech."
  ],
  "tweet_settings": {
    "enabled": true,
    "interval_hours": 1
  },
  "filters": {
    "exclude_retweets": true,
    "exclude_own_tweets": true,
    "exclude_replied_tweets": true,
    "min_followers": 0
  }
}

